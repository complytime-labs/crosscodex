                    "rel": "external_reference",
                    "text": "1.10"
                  },
                  {
                    "href": "#990b58bf-e88e-4ed0-95dd-f52e6b933d60",
                    "rel": "external_reference",
                    "text": "PC1-A, PC1-B, PC2-A"
