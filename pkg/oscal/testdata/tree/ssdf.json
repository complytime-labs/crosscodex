    "groups": [
      {
        "id": "PO",
        "class": "group",
        "title": "Prepare the Organization",
        "props": [
          {
            "name": "sort-id",
            "value": "000001"
          },
          {
            "name": "label",
            "value": "Prepare the Organization (PO)"
          }
        ],
        "parts": [
          {
            "id": "overview_PO",
            "name": "overview",
            "prose": "Organizations should ensure that their people, processes, and technology are prepared to perform secure software development at the organization level. Many organizations will find some PO practices to also be applicable to subsets of their secure software development, like individual development groups or projects."
          }
        ],
        "controls": [
          {
            "id": "PO.1",
            "class": "practice",
            "title": "Define Security Requirements for Software Development",
            "props": [
              {
                "name": "sort-id",
                "value": "000001.000001"
              },
              {
                "name": "label",
                "value": "Define Security Requirements for Software Development (PO.1)"
              }
            ],
            "parts": [
              {
                "id": "statement_PO.1",
                "name": "statement",
                "prose": "Ensure that security requirements for software development are known at all times so that they can be taken into account throughout the SDLC and duplication of effort can be minimized because the requirements information can be collected once and shared. This includes requirements from internal sources (e.g., the organization’s policies, business objectives, and risk management strategy) and external sources (e.g., applicable laws and regulations)."
              }
            ],
            "controls": [
              {
                "id": "PO.1.1",
                "class": "task",
                "title": "PO.1.1",
                "props": [
                  {
                    "name": "sort-id",
                    "value": "000001.000001.000001"
                  },
                  {
                    "name": "label",
                    "value": "PO.1.1"
                  }
                ],
                "links": [
                  {
                    "href": "#00b12b29-654e-4fbb-8db0-6a156deb7eb4",
