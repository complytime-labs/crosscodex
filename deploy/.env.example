# Postgres superuser password for the db container. Only the db and the
# one-shot migrate service receive it; crosscodexd never does. It is embedded
# in the migrate service's postgres:// URL, so it must be URL-safe: use hex,
# e.g. openssl rand -hex 24 (task deploy:up refuses other characters).
POSTGRES_PASSWORD=change-me

# Passwords for the restricted roles crosscodexd runs as (app_user for
# relational data, graph_user for the AGE graph). The migrate service sets
# them from these values on every start of the stack. They are embedded in
# postgres:// URLs, so they must be URL-safe: use hex, e.g.
#   openssl rand -hex 24
# (task deploy:up refuses characters other than A-Z a-z 0-9 . _ ~ -)
APP_USER_PASSWORD=change-me-app-user
GRAPH_USER_PASSWORD=change-me-graph-user

# Upstream model provider key that LiteLLM uses to reach the real model API
# (e.g. OpenAI). Consumed by deploy/litellm/config.yaml.
OPENAI_API_KEY=sk-your-provider-key

# The key CrossCodex presents to LiteLLM (referenced by config.yaml
# api_key_ref: env:CROSSCODEX_LLM_API_KEY). Must match a LiteLLM virtual key.
CROSSCODEX_LLM_API_KEY=sk-crosscodex-to-litellm

# Model aliases the daemon requests (must exist in deploy/litellm/config.yaml).
CROSSCODEX_LLM_DEFAULT_MODEL=default
CROSSCODEX_LLM_EMBEDDING_MODEL=embed

# Image tag to run (defaults to latest).
TAG=latest

# Backups (compose.backup.yaml): backup_user's DSN. crosscodexd migrate sets
# backup_user's password from this DSN on every start of the stack. Uncomment
# and set a real hex password (openssl rand -hex 24); unedited, it would set
# the password to "change-me".
# CROSSCODEX_BACKUP_DSN=postgres://backup_user:change-me@db:5432/crosscodex?sslmode=verify-full&sslrootcert=/certs/ca.pem&sslcert=/certs/client.pem&sslkey=/certs/client-key.pem
# S3 destination only: credentials for crosscodexd (the AWS credential chain).
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# Tenant administration (crosscodexd admin tenant). tenant_admin's DSN.
# crosscodexd migrate sets tenant_admin's password from this DSN on every
# start of the stack; use a hex password (openssl rand -hex 24). Uncomment and
# set a real password; left as is, migrate would set it to "change-me".
# CROSSCODEX_DATABASE_TENANT_ADMIN_DSN=postgres://tenant_admin:change-me@db:5432/crosscodex?sslmode=verify-full&sslrootcert=/certs/ca.pem&sslcert=/certs/client.pem&sslkey=/certs/client-key.pem
