# LiteLLM proxy config for the deploy SMOKE stack backed by a self-hosted
# OpenAI-compatible server (llama.cpp, vLLM, LocalAI, ...) (template).
#
# Do not edit for local overrides. test/deploy/smoke_up.sh renders it when
# OPENAI_COMPAT_HOST is set, through scripts/generate-llm-gateway-config.sh.
# It shares the Ollama template's placeholders (named after Ollama, so they
# are not repeated here, where the renderer would substitute them): api_base
# becomes OPENAI_COMPAT_HOST + /v1, and the model names become
# OPENAI_COMPAT_CHAT_MODEL and OPENAI_COMPAT_EMBED_MODEL.
#
# Same aliases as deploy/litellm/config.yaml (default, panel-1..3 + embed), so
# the daemon requests the same model names as in production. panel-1..3 take
# the three names of OPENAI_COMPAT_PANEL_MODELS (default
# qwen3.8-flash-next,gpt-oss-120b,qwen3.8-27b), which the renderer validates;
# they should be different model families, which the daemon checks at run time.
#
# extra_body limits the chat model's reasoning. Analyzers give the model a
# small answer budget (max_tokens in deploy/config.yaml); a reasoning model
# spends it on reasoning and returns empty content. llama.cpp passes
# chat_template_kwargs to the model's chat template, and a template ignores
# the kwargs it does not use, so both are safe for every model:
# enable_thinking: false turns Qwen3-family thinking off; gpt-oss ignores it
# and reasons at its template's reasoning_effort (default medium), so
# reasoning_effort: "low" caps it. gpt-oss still reasons a little at low:
# deploy/config.yaml sizes the panel analyzers' max_tokens for that.
#
# The api_key is a required-but-ignored placeholder. master_key is kept from
# the production config so the daemon -> LiteLLM auth stays under test.
model_list:
  - model_name: default
    litellm_params:
      model: openai/OLLAMA_CHAT_MODEL
      api_base: OLLAMA_API_BASE
      api_key: "sk-unused"
      extra_body:
        chat_template_kwargs:
          enable_thinking: false
          reasoning_effort: "low"
  - model_name: panel-1
    litellm_params:
      model: openai/OLLAMA_PANEL_1_MODEL
      api_base: OLLAMA_API_BASE
      api_key: "sk-unused"
      extra_body:
        chat_template_kwargs:
          enable_thinking: false
          reasoning_effort: "low"
  - model_name: panel-2
    litellm_params:
      model: openai/OLLAMA_PANEL_2_MODEL
      api_base: OLLAMA_API_BASE
      api_key: "sk-unused"
      extra_body:
        chat_template_kwargs:
          enable_thinking: false
          reasoning_effort: "low"
  - model_name: panel-3
    litellm_params:
      model: openai/OLLAMA_PANEL_3_MODEL
      api_base: OLLAMA_API_BASE
      api_key: "sk-unused"
      extra_body:
        chat_template_kwargs:
          enable_thinking: false
          reasoning_effort: "low"
  - model_name: embed
    litellm_params:
      model: openai/OLLAMA_EMBED_MODEL
      api_base: OLLAMA_API_BASE
      api_key: "sk-unused"

general_settings:
  telemetry: false
  master_key: os.environ/CROSSCODEX_LLM_API_KEY
