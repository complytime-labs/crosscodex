# WAL-G settings for the db service (WAL archiving) and the db-restore
# one-shot. Copy to backup.env (gitignored). Must point at the same
# destination as backup.config.yaml.

# Local destination (the crosscodex-backup volume, mounted at /backup):
WALG_FILE_PREFIX=/backup/postgres

# S3 destination instead: comment out WALG_FILE_PREFIX and set
# WALG_S3_PREFIX=s3://crosscodex-backup/postgres
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# S3-compatible stores only:
# AWS_ENDPOINT=https://s3.example.internal
# AWS_S3_FORCE_PATH_STYLE=true
