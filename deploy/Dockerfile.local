# syntax=docker/dockerfile:1

# Fast local build path: copy host-built static binaries into distroless,
# skipping the in-container Go build. Selected via `task deploy:build LOCAL=1`
# (or any deploy:* task with LOCAL=1), which first runs `task dev:build` with
# CGO_ENABLED=0 and GOOS/GOARCH pinned to the target, then builds this file with
# the bin/ output directory as the context.
#
# The binaries MUST be static (CGO_ENABLED=0) and target linux/<image-arch> to
# run in distroless -- the deploy:build:local task enforces this. For
# reproducible, CI-identical release images use the hermetic multi-stage build in
# ./Dockerfile instead; this path trades that hermeticity for build speed and
# depends on the host Go toolchain. The daemon image is distroless/base
# (WAL-G release binaries link glibc); the CLI image stays distroless/static.

# WAL-G for the daemon image; fetch-walg.sh is copied into the bin/ build
# context by `task deploy:build LOCAL=1`.
FROM docker.io/library/debian:bookworm-slim AS walg
# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
COPY fetch-walg.sh /tmp/fetch-walg.sh
RUN mkdir /out && sh /tmp/fetch-walg.sh /out

FROM gcr.io/distroless/base-debian12:nonroot AS crosscodexd
COPY crosscodexd /crosscodexd
COPY --from=walg /out/wal-g /usr/local/bin/wal-g
USER nonroot:nonroot
ENTRYPOINT ["/crosscodexd"]

FROM gcr.io/distroless/static-debian12:nonroot AS crosscodex-cli
COPY crosscodex /crosscodex
USER nonroot:nonroot
ENTRYPOINT ["/crosscodex"]
